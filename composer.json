{
    "name": "yourvendor/laravel-rag",
    "description": "A production-ready RAG (Retrieval-Augmented Generation) package for Laravel using pgvector and Livewire",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your@email.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/ai": "^0.6.8",
        "livewire/livewire": "^4.0",
        "pgvector/pgvector": "^0.2.0",
        "spatie/pdf-to-text": "^1.55",
        "phpoffice/phpspreadsheet": "^5.7",
        "phpoffice/phpword": "^1.4",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "laravel/sail": "^1.53",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "YourVendor\\LaravelRag\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourVendor\\LaravelRag\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YourVendor\\LaravelRag\\RagServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

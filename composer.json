{
  "name": "cla/laravel-rag",
  "description": "A production-ready RAG (Retrieval-Augmented Generation) package for Laravel using pgvector and Livewire",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "your@email.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "laravel/ai": "^0.6.8",
    "livewire/livewire": "^3.0 || ^4.0",
    "pgvector/pgvector": "^0.2.0",
    "spatie/pdf-to-text": "^1.55",
    "phpoffice/phpspreadsheet": "^5.7",
    "phpoffice/phpword": "^1.4",
    "smalot/pdfparser": "^2.12"
  },
  "require-dev": {
    "laravel/sail": "^1.40",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0 || ^4.0",
    "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
    "laravel/pint": "^1.20"
  },
  "autoload": {
    "psr-4": {
      "CLA\\LaravelRag\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CLA\\LaravelRag\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CLA\\LaravelRag\\RagServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/pest",
    "format": "vendor/bin/pint"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
